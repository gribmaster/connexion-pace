// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

enum Locale {
  ET
  EN
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String            @id @default(cuid())
  email             String?           @unique
  privacyAcceptedAt DateTime?
  name              String?
  createdAt         DateTime          @default(now())
  stripeCustomerId  String?           @unique
  subscription      UserSubscription?
}

enum SubscriptionStatus {
  active
  trialing
  past_due
  canceled
  unpaid
  incomplete
  incomplete_expired
  paused
}

model UserSubscription {
  id                   String             @id @default(cuid())
  userId               String             @unique
  stripeSubscriptionId String             @unique
  stripePriceId        String
  status               SubscriptionStatus
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean            @default(false)
  cancelAt             DateTime?
  canceledAt           DateTime?
  endedAt              DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  user                 User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Card {
  id          String   @id @default(cuid())
  title       String
  description String
  additional  String?
  imageUrl    String?
  category    Category
  isFree      Boolean  @default(false)
  createdAt   DateTime @default(now())
  translations CardTranslation[]
}

model CardTranslation {
  id          String   @id @default(cuid())
  cardId      String
  locale      Locale
  title       String
  description String
  additional  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  card        Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@unique([cardId, locale])
}

enum Category {
  CONNECTION
  INTIMACY
  LOVEMAKING
}

enum NotificationStatus {
  SCHEDULED
  SENT
  FAILED
  CANCELLED
}

enum DailyConnectionStatus {
  ACTIVE
  PAUSED
  CANCELLED
}

model PushSubscription {
  id        String   @id @default(cuid())

  userId    String?
  endpoint  String   @unique
  p256dh    String
  auth      String

  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  playReminders        PlayReminder[]
  dailyConnectionRules DailyConnectionReminder[]
}

model PlayReminder {
  id                 String             @id @default(cuid())

  userId             String?
  pushSubscriptionId String

  scheduledAt        DateTime
  timezone           String?
  title              String
  body               String
  status             NotificationStatus @default(SCHEDULED)

  sentAt             DateTime?
  failedAt           DateTime?
  failureReason      String?

  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  pushSubscription   PushSubscription   @relation(fields: [pushSubscriptionId], references: [id], onDelete: Cascade)

  @@index([scheduledAt, status])
  @@index([userId])
  @@index([pushSubscriptionId])
}

model DailyConnectionReminder {
  id                 String                @id @default(cuid())

  userId             String?
  pushSubscriptionId String

  timeOfDay          String
  timezone           String?
  intervalDays       Int

  nextRunAt          DateTime
  lastSentAt         DateTime?

  title              String
  body               String
  status             DailyConnectionStatus @default(ACTIVE)

  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  pushSubscription   PushSubscription      @relation(fields: [pushSubscriptionId], references: [id], onDelete: Cascade)

  @@index([nextRunAt, status])
  @@index([userId])
  @@index([pushSubscriptionId])
}
